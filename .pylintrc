[TYPECHECK]
# Super-Linter does not install these scripts' PEP 723 dependencies.
# Keep this allowlist limited to packages declared in script metadata.
ignored-modules=atomicwrites,click,httpx,numpy,pandas,pydantic,semver,ta,yfinance
# Click supplies callback arguments when invoking decorated CLI commands.
signature-mutators=click.command,click.group,click.decorators.command,click.decorators.group

[FORMAT]
# Match the Flake8 source-line limit; Black still wraps expressions at 88.
max-line-length=120